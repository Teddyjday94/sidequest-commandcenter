{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "workflow_id", "agent_id", "kind", "lead_id", "status", "summary", "evidence", "confidence", "completed_operations", "blockers", "next_handoff", "output"],
  "properties": {
    "job_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "kind": {"const": "contact_verification"},
    "lead_id": {"type": ["string", "null"]},
    "status": {"enum": ["completed", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}, "maxItems": 50},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "completed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 50},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 50},
    "next_handoff": {"type": "string", "minLength": 1, "maxLength": 1000},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "contact_routes"],
      "properties": {
        "facts": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 100},
        "contact_routes": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 25}
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "source_url", "source_label", "observed_at", "confidence"],
      "properties": {
        "fact": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "observed_at": {"type": "string", "minLength": 1, "maxLength": 64},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
