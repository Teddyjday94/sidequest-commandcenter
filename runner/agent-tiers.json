    "qualification": {
      "tier": "standard",
      "prompt": "agents/codex/opportunity-analyst.md",
      "schema": "runner/job-schemas/qualification.json",
      "tools": ["supabase"]
    },
    "draft": {
      "tier": "standard",
      "prompt": "agents/codex/content-agent.md",
      "schema": "runner/job-schemas/draft.json",
      "tools": ["supabase"]
    },
    "review": {
      "tier": "standard",
      "prompt": "agents/codex/quality-reviewer.md",
      "schema": "runner/job-schemas/review.json",
      "tools": ["supabase"]
