    },
    "content-agent": {
      "kinds": ["draft"],
      "tier": "standard",
      "prompt": "agents/codex/content-agent.md",
      "tools": ["supabase"]
    },
    "quality-reviewer": {
      "kinds": ["review"],
      "tier": "standard",
